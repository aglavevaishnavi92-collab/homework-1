#include <stdio.h>
struct Employee {
    int id;
    char name[30];
    float salary;
};

int main() {
    struct Employee e[5];
    int i;
    float total = 0;

    for(i = 0; i < 5; i++) {
        printf("\nEnter ID, Name and Salary: ");
        scanf("%d %s %f",&e[i].id,e[i].name,&e[i].salary);

        total = total + e[i].salary;
    }    

    printf("\nTotal Salary of ALL Employees = %.2f", total);
    return 0;

}
 